{
  "name": "nexora",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "env:check": "node scripts/doctor.mjs",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @nexora/web dev",
    "dev:api": "pnpm --filter @nexora/api dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @nexora/web test:e2e",
    "db:generate": "pnpm --filter @nexora/db generate",
    "db:migrate": "pnpm --filter @nexora/db migrate",
    "db:studio": "pnpm --filter @nexora/db studio",
    "db:seed": "pnpm --filter @nexora/db seed",
    "ai:evals": "pnpm --filter @nexora/ai evals",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,md,json,css}\"",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "@nexora/config": "workspace:*",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.12",
    "typescript": "^6.0.3",
    "@neondatabase/serverless": "^1.1.0"
  }
}
