{
  "name": "nexora",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @nexora/web dev",
    "dev:api": "pnpm --filter @nexora/api dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "pnpm --filter @nexora/web test:e2e",
    "db:generate": "pnpm --filter @nexora/db generate",
    "db:migrate": "pnpm --filter @nexora/db migrate",
    "db:studio": "pnpm --filter @nexora/db studio",
    "db:seed": "pnpm --filter @nexora/db seed",
    "ai:evals": "pnpm --filter @nexora/ai evals",
    "format": "prettier --write \"**/*.{ts,tsx,md,json}\"",
    "verify": "pnpm typecheck && pnpm lint && pnpm test"
  },
  "devDependencies": {
    "turbo": "^2.3.0",
    "typescript": "^5.7.0",
    "prettier": "^3.4.0"
  }
}
