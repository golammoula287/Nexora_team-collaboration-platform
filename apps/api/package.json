    "hono": "^4.13.5",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@nexora/config": "workspace:*",
    "@types/node": "^26.4.1",
    "eslint": "^10.9.1",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11"
  }
